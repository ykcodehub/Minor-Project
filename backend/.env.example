# PostgreSQL is required for the application. Never put real credentials in this template.
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Explicit isolated automated tests alone may use SQLite with ENVIRONMENT=test.
ENVIRONMENT=development
SECURE_COOKIES=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_URL=http://localhost:5173
STORAGE_PATH=private-data
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Production requires a stable secret key, shared by API and worker. Never commit it.
STORAGE_KEY=
MAX_UPLOAD_BYTES=20971520
MAX_PAGES=150
MAX_DOCUMENT_TOKENS=100000
# Set only provider/model pairs you are authorized to use. No model availability is assumed.
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional current USD price estimates. No defaults or free-tier claims are assumed.
# PROVIDER_PRICING={"gemini":{"input_price_per_million":0.0,"output_price_per_million":0.0}}
# Email registration requires real verification in every non-test environment. No local activation bypass.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Google Cloud Web application OAuth client. Place real values only in private backend/.env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the exact authorized redirect URI in Google Cloud; HTTPS in production.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback
# TEST_MAIL_OUTBOX is a private capture transport ONLY with ENVIRONMENT=test; never set in deployments.

# Production object storage: never use the development filesystem backend in production.
STORAGE_BACKEND=filesystem
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_PREFIX=veriora/
# Supply AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/(optional AWS_SESSION_TOKEN) as process secrets,
# or prefer an IAM role. API and worker must share the same bucket/prefix/key.
# Same-origin Vercel proxy: explicit HTTPS backend ingress hostnames, no schemes/paths.
OAUTH_PROXY_HOSTS=

# Cloudflare R2 uses STORAGE_BACKEND=s3, S3_REGION=auto, and its private HTTPS S3 API endpoint.
# Set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY as host process secrets, not public frontend values.
# Production failures log a safe policy code and variable names; no filesystem bypass exists.

# Default/recommended: first-party Vercel /api proxy uses lax cookies.
# Direct cross-site API requires none + SECURE_COOKIES=true and still faces mobile third-party-cookie blocking.
SESSION_COOKIE_SAMESITE=lax

# Optional conservative model/task request limits; calibrated to your provider plan, not advertised context size alone.
# Keys: provider name or provider/model-id. Values: request_tokens, context_tokens, max_output_tokens, max_payload_bytes.
PROVIDER_LIMITS={}
MAX_AI_CALLS_PER_OPERATION=100
MAX_AI_TOKENS_PER_OPERATION=500000

# PROVIDER_LIMITS also accepts exact model IDs, e.g. "openrouter/free".
# Precedence: provider -> exact model ID -> namespaced provider/model-id.
# Router context is unknown until selected; do not invent a large model context to bypass the cap.
